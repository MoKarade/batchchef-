{
  "version": 1,
  "repo_label": "BatchChef",
  "comment": "Toute l'app vit dans web/ : découpage par couche et par domaine (API et accès, MCP, LLM et import, données, logique cuisine, interface, tests, outillage, docs). Le premier motif qui correspond gagne : les dossiers spécifiques de web/lib passent avant web/lib/**.",
  "sources": [
    { "name": "01_API_Acces_Hub", "title": "Routes API, summary du hub, authentification et accès",
      "include": ["web/app/api/hub/**", "web/app/api/auth/**", "web/app/api/sante/**", "web/middleware.ts", "web/auth.ts",
                  "web/types/**", "web/lib/hubSummary.ts", "web/lib/accesHub.ts", "web/lib/authConfigured.ts",
                  "web/lib/authGuard.ts", "web/lib/authorized.ts", "web/lib/sessionPartagee.ts", "web/lib/origine.ts",
                  "web/lib/urlPublique.ts"] },
    { "name": "02_MCP_OAuth", "title": "Serveur MCP, OAuth du connecteur et fonctions internes",
      "include": ["web/app/api/mcp/**", "web/app/.well-known/**", "web/lib/mcp/**", "web/lib/actionsInternes/**"] },
    { "name": "03_LLM_Import_Assistant", "title": "LLM : import de recettes (URL, vidéo, audio), prix, assistant",
      "include": ["web/app/api/transcription/**", "web/lib/llm/**", "web/lib/llmUsage.ts", "web/lib/assistant/**",
                  "web/lib/audio/**", "web/lib/video/**", "web/lib/transcription.ts", "web/lib/actions/import.ts",
                  "web/lib/actions/assistant.ts"] },
    { "name": "04_Donnees_Schemas", "title": "Base de données : schéma Drizzle, migrations, import du catalogue",
      "include": ["web/lib/db/**", "web/drizzle/**", "web/drizzle.config.ts", "web/scripts/import-catalog.ts",
                  "web/scripts/reparer-ingredients.ts", "web/scripts/vercel-build.*"] },
    { "name": "05_Logique_Cuisine", "title": "Logique métier : recettes, ingrédients, batchs, courses, semaine",
      "include": ["web/lib/**"] },
    { "name": "06_Interface", "title": "Interface : pages, composants, PWA",
      "include": ["web/app/**", "web/components/**", "web/public/**"] },
    { "name": "07_Tests", "title": "Tests Vitest et mutation",
      "include": ["web/tests/**", "web/vitest*.ts", "web/stryker.config.mjs"] },
    { "name": "08_CI_Config_Outils", "title": "CI, fusion automatique, portes qualité et configuration",
      "include": [".github/**", ".claude/**", "modeles/**", "scripts/**", "web/qualite/**", "web/scripts/**",
                  "web/package.json", "web/tsconfig.json", "web/next.config.ts", "web/eslint.config.mjs", "web/knip.json",
                  "web/vercel.json", "web/postcss.config.mjs", "web/.dependency-cruiser.cjs", "web/.env.example",
                  "web/.gitignore", ".gitattributes", ".gitignore", ".gitleaksignore", ".nvmrc"] },
    { "name": "09_Docs_Handover", "title": "Documentation, ADR, maquettes, passation et backlog",
      "include": ["CLAUDE.md", "HANDOVER.md", "BACKLOG.md", "COPIES.md", "web/README.md", "docs/**"] }
  ],
  "fallback": "99_Autres",
  "master": { "enabled": true,
    "include": ["README.md", "web/lib/db/schema.ts", "web/types/next-auth.d.ts", "web/app/api/hub/summary/route.ts",
                "web/lib/hubSummary.ts", "web/app/api/mcp/route.ts", "web/lib/mcp/declarations.ts", "web/lib/mcp/outils.ts",
                "web/lib/mcp/protocole.ts", "web/lib/accesHub.ts", "web/lib/sessionPartagee.ts", "web/lib/authGuard.ts",
                "web/middleware.ts", "web/lib/llmUsage.ts"],
    "exclude": ["docs/**"] },
  "limits": { "max_words_per_doc": 400000, "max_chars_per_doc": 900000, "max_json_bytes": 40000 }
}
