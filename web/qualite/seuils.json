    "archi": [
      "app",
      "lib",
      "components",
      "scripts"
    ],
    "vitest_args": "--coverage.reporter=lcov"
  },
  "portes": {
    "typecheck.erreurs": {
      "max": 0
    },
    "lint.erreurs": {
      "max": 0
    },
    "lint.avertissements": {
      "max": 0
    },
    "tests.echecs": {
      "max": 0
    },
    "couverture.lignes_coeur": {
      "min": 53
    },
    "couverture.lignes_global": {
      "min": 29.5
    },
    "couverture.branches_global": {
      "min": 92.5
    },
    "code_mort.problemes": {
      "max": 17
