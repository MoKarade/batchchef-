# BatchChef web — configuration (à copier en .env.local, JAMAIS committé).

# --- Base de données (Neon, gratuit : https://neon.tech) ---
# Console Neon → ton projet → Connection string (pooled)
DATABASE_URL=

# --- Authentification (Auth.js v5) — même pattern que Hubperso ---
# Client OAuth Google "Web application". Redirect URI à ajouter dans Google Cloud Console :
#   http://localhost:3000/api/auth/callback/google
#   https://<ton-projet>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Générer : npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET=
# UNIQUE adresse Google admise
AUTHORIZED_EMAIL=

# --- LLM (parse des recettes + estimation de budget) ---
ANTHROPIC_API_KEY=
# Optionnel : override du modèle (défaut : claude-haiku-4-5-20251001)
# BATCHCHEF_LLM_MODEL=

# --- Hub perso (endpoint GET /api/hub/summary) ---
# Jeton partagé présenté par le hub dans l'en-tête x-hub-token. MÊME valeur que
# HUB_TOKEN_BATCHCHEF côté Hubperso. Générer : openssl rand -base64 32
HUB_TOKEN=
# URL publique de BatchChef (sert à construire les liens du summary). Défaut : l'URL Vercel.
# BATCHCHEF_PUBLIC_URL=https://batchchef-glu8-chi.vercel.app
